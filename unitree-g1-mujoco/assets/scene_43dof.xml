<mujoco model="g1 astra grasp scene">
  <include file="g1_29dof_with_hand.xml"/>
  <include file="coffee_workspace.xml"/>

  <!-- Adapted from gpt6-astra-direct/runtime/g1-cup-grasp/scene/scene_grasp.xml.
       The current floating-base G1/Dex3 model and simulator contracts are retained. -->
  <option impratio="50" cone="elliptic" noslip_iterations="15"/>
  <statistic center="0.4 0 0.8" extent="1.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.85" rgb2="0.2 0.25 0.35" width="256" height="1536"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="astra_table" rgba="0.28 0.34 0.40 1"/>
    <material name="astra_table_leg" rgba="0.08 0.10 0.12 1"/>
    <material name="ceramica_branca" rgba="0.96 0.96 0.96 1" emission="0.55" specular="0.05" shininess="0.1"/>
    <mesh name="astra_cup" file="../cup.stl" scale="0.0013 0.0013 0.0013"/>
  </asset>
  <worldbody>
    <light pos="0.5 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <!-- Astra work table: 50 x 100 cm top at 75 cm. -->
    <body name="mesa" pos="0.45 0 0.375">
      <geom name="geometria_mesa" type="box" size="0.25 0.5 0.375"
        rgba="0.28 0.34 0.40 0" friction="1 0.005 0.0001"/>
      <geom name="table_visual" type="box" pos="0 0 0.355" size="0.25 0.5 0.020"
        material="astra_table" contype="0" conaffinity="0" density="0"/>
      <geom name="table_leg_1" type="box" pos="-0.21 -0.45 -0.02" size="0.025 0.025 0.355"
        material="astra_table_leg" contype="0" conaffinity="0" density="0"/>
      <geom name="table_leg_2" type="box" pos="-0.21 0.45 -0.02" size="0.025 0.025 0.355"
        material="astra_table_leg" contype="0" conaffinity="0" density="0"/>
      <geom name="table_leg_3" type="box" pos="0.21 -0.45 -0.02" size="0.025 0.025 0.355"
        material="astra_table_leg" contype="0" conaffinity="0" density="0"/>
      <geom name="table_leg_4" type="box" pos="0.21 0.45 -0.02" size="0.025 0.025 0.355"
        material="astra_table_leg" contype="0" conaffinity="0" density="0"/>
    </body>

    <!-- Keep the names consumed by base_sim.py and pickup tooling. -->
    <body name="objeto_customizado" pos="0.35 -0.10 0.80">
      <freejoint name="junta_livre_bloco"/>
      <geom name="copo_geom_visual" type="mesh" mesh="astra_cup"
        material="ceramica_branca" contype="0" conaffinity="0" mass="0"/>
      <geom name="geometria_bloco" type="cylinder" size="0.039 0.046" pos="0 0 0.046"
        rgba="0 0 0 0" mass="0.1" condim="4" friction="8.0 0.3 0.0" priority="2"
        solref="0.005 1.0" solimp="0.99 0.999 0.0001 0.5 2"/>
    </body>

    <geom name="marker_red" type="box" pos="0.50 -0.40 0.7505" size="0.016 0.016 0.0004"
      rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0" density="0"/>
    <geom name="marker_cyan" type="box" pos="0.66 -0.36 0.7505" size="0.016 0.016 0.0004"
      rgba="0.05 0.95 0.95 1" contype="0" conaffinity="0" density="0"/>
    <geom name="marker_blue" type="box" pos="0.66 0.36 0.7505" size="0.016 0.016 0.0004"
      rgba="0.08 0.12 0.95 1" contype="0" conaffinity="0" density="0"/>
    <geom name="marker_magenta" type="box" pos="0.50 0.40 0.7505" size="0.016 0.016 0.0004"
      rgba="0.95 0.08 0.95 1" contype="0" conaffinity="0" density="0"/>

    <camera name="view_left" pos="0.45 1.25 1.15"
      xyaxes="-0.99920 0.03997 0.00000 -0.00932 -0.23301 0.97243" fovy="40"/>
    <camera name="view_center" pos="2.1 0.0 1.25"
      xyaxes="0.00000 1.00000 0.00000 -0.22282 0.00000 0.97486" fovy="38"/>
    <camera name="side_view" pos="0.45 -1.25 1.15"
      xyaxes="0.9965 0.083 0 -0.023 0.278 0.960" fovy="40"/>
    <camera name="global_view" pos="1.6 -1.4 1.5"
      xyaxes="0.66 0.75 0 -0.35 0.31 0.88" fovy="45"/>
  </worldbody>
  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
